{
    "name": "crewora",
    "version": "1.0.0",
    "main": "electron/main.js",
    "homepage": "./",
    "scripts": {
        "start": "electron .",
        "build:ui": "cd frontend && npm run build",
        "build": "npm run build:ui && electron-builder"
    },
    "build": {
        "appId": "com.crewora.offline",
        "productName": "Crewora Offline",
        "directories": {
            "output": "release",
            "buildResources": "assets"
        },
        "files": [
            "electron/**/*",
            "frontend/dist/**/*",
            "package.json"
        ],
        "extraResources": [
            {
                "from": "backend",
                "to": "backend"
            }
        ],
        "win": {
            "target": "nsis",
            "icon": "assets/icon.ico"
        }
    },
    "devDependencies": {
        "electron": "^32.3.3",
        "electron-builder": "^25.1.8"
    },
    "dependencies": {
        "@electric-sql/pglite": "*",
        "@vitejs/plugin-react-swc": "^4.2.2",
        "body-parser": "*",
        "cors": "*",
        "express": "*",
        "express-session": "*"
    }
}
